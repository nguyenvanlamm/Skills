services:
  - type: web
    name: {{slug}}-server
    runtime: docker
    repo: https://github.com/{{gh_user}}/{{slug}}-server
    branch: main
    plan: free
    dockerfilePath: ./Dockerfile
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: {{slug}}-db
          property: connectionString
      - key: PORT
        value: 8000

databases:
  - name: {{slug}}-db
    plan: free
    region: oregon
    version: "16"
