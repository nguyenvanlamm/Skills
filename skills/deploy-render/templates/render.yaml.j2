services:
  - type: web
    name: {{slug}}-server
    runtime: docker
    repo: https://github.com/{{gh_user}}/{{slug}}-server
    branch: main
    plan: free
    region: {{region}}
    dockerfilePath: ./Dockerfile
    healthCheckPath: {{health_path}}
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: {{slug}}-db
          property: connectionString
      - key: PORT
        value: 8000
      - key: WEB_CONCURRENCY
        value: 2

databases:
  - name: {{slug}}-db
    plan: free
    region: {{region}}
    postgresMajorVersion: "16"
